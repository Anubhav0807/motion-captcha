# ---- required ----------------------------------------------------------
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/motion_captcha
# Long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ---- URLs --------------------------------------------------------------
# Where the dashboard is reachable (links in emails, Stripe redirects)
APP_URL=http://localhost:5174
# Where customers' browsers reach this API (used in challenge URLs and snippets)
PUBLIC_API_URL=http://localhost:8000

# ---- sessions ----------------------------------------------------------
# Set to false only for local http:// development
COOKIE_SECURE=false
SESSION_DAYS=30
# true when running behind a reverse proxy / load balancer that sets X-Forwarded-For
TRUST_PROXY=false

# ---- email (optional; without SMTP_HOST emails are printed to the log) --
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=motion-captcha <no-reply@yourdomain.com>
SMTP_STARTTLS=true
# Receives rate-limit increase requests
SUPPORT_EMAIL=

# ---- Stripe (optional; without it billing endpoints return 503) --------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# ---- model / assets ----------------------------------------------------
MODEL_PATH=./assets/models/risk_model.joblib
CAPTCHA_FONT_PATH=./assets/fonts/anniesgrids.ttf
# Required by TabPFN
TABPFN_TOKEN=

# ---- internal ----------------------------------------------------------
# Enables POST /internal/training-metrics for collecting labelled data. Empty = disabled.
INTERNAL_API_TOKEN=

# ---- production: serve the built dashboard from this API ---------------
# DASHBOARD_DIST=../dashboard/dist

# test database (pytest drops and recreates every table in it)
# TEST_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/motion_captcha_test
