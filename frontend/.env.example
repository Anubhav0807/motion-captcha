# Where the backend's public CAPTCHA API is reachable by your customers' browsers.
# Used in the integration snippets shown to customers. Defaults to this site's origin.
VITE_PUBLIC_API_URL=https://api.yourdomain.com

# Link shown in the sidebar
VITE_DOCS_URL=https://docs.yourdomain.com

# Dev server only: where `npm run dev` proxies /api and /v1
VITE_DEV_PROXY_TARGET=http://localhost:8000
