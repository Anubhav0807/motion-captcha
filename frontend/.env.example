# Base URL of your backend REST API (no trailing slash).
# Use a relative path like /api/v1 when the console is served from the same domain.
VITE_API_BASE_URL=/api/v1

# true  = run fully in the browser against the built-in mock backend (demo / UI work)
# false = talk to the real backend at VITE_API_BASE_URL
VITE_USE_MOCK=true

# Branding
VITE_APP_NAME=Keystone
VITE_DOCS_URL=https://docs.example.com
VITE_KEY_PREFIX=ks_live_

# Dev server proxy target for /api (only used by `npm run dev`)
VITE_DEV_PROXY_TARGET=http://localhost:8080
